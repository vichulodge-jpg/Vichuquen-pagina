{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron-pre-llegada",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    { "source": "/admin",  "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" }
  ],
  "redirects": [
    { "source": "/cabañas", "destination": "/cabanas", "permanent": true },
    { "source": "/experiencia", "destination": "/experiencias", "permanent": true },
    { "source": "/reserva", "destination": "/reservas", "permanent": true },
    { "source": "/reservar", "destination": "/reservas", "permanent": true },
    { "source": "/grupos-y-eventos", "destination": "/grupos", "permanent": true },
    { "source": "/como-llegar", "destination": "/ubicacion", "permanent": true }
  ],
  "headers": [
    {
      "source": "/:path*.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/:path*.css",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/:path*.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    },
    {
      "source": "/:path*.jpg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }]
    },
    {
      "source": "/:path*.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }]
    },
    {
      "source": "/:path*.woff2",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }]
    }
  ]
}
